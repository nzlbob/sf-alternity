<form class="{{cssClass}} flexcol" autocomplete="off">

    {{!-- Item Sheet Header --}}
    <header class="sheet-header flexrow">
        <img class="profile" src="{{item.img}}" title="{{item.name}}" data-edit="img"/>

        <div class="header-details flexrow">
            <h1 class="charname">
                <input name="name" type="text" value="{{item.name}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.ItemName" }}"/>
            </h1>

            <div class="item-subtitle">
                <h4 class="item-type">{{itemType}}</h4>
                <span class="item-status">{{itemStatus}}</span>
            </div>

            <ul class="summary">
                <li>
                    <input type="text" name="system.source" value="{{itemData.source}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.Source" }}"/>
                </li>
                <li>
                    <input type="text" name="system.type" value="{{itemData.type}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.Type" }}" />
                </li>
                <li>
                    <input type="text" name="system.subtype" value="{{itemData.subtype}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.Subtype" }}" />
                </li>
            </ul>
        </div>
    </header>

    {{!-- Item Sheet Navigation --}}
    <nav class="sheet-navigation tabs" data-group="primary">
        <a class="item active" data-tab="description">{{ localize "SFRPG.Description" }}</a>
        <a class="item" data-tab="details">{{ localize "SFRPG.Details" }}</a>
        <a class="item" data-tab="modifiers">{{ localize "SFRPG.Modifiers" }}</a>
    </nav>

    {{!-- Item Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        {{> "systems/sfrpg/templates/items/parts/item-description.hbs"}}

        {{!-- Details Tab --}}
        <div class="tab details" data-group="primary" data-tab="details">

            <div class="bubble">
                <h3 class="bubble-header">{{localize "SFRPG.RacialTraits"}}</h3>

                <div class="bubble-info">
                    {{!-- Hit points --}}
                    <div class="form-group">
                        <label>{{localize "SFRPG.RaceHitPoints"}}</label>
                        <div class="form-fields">
                            <input type="text" name="system.hp.value" value="{{itemData.hp.value}}" data-dtype="Number" />
                        </div>
                    </div>

                    {{!-- Size --}}
                    <div class="form-group">
                        <label>{{localize "SFRPG.RaceSize"}}</label>
                        <div class="form-fields">
                            <select name="system.size">
                                {{selectOptions (sfrpg "actorSizes") selected=itemData.size}}
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>{{localize "SFA.Species.MaxSkillPointsAdjustment.Label"}}</label>
                        <div class="form-fields">
                            <input type="number" name="flags.sf-alternity.species.maxSkillPointsAdjustment" value="{{item.flags.sf-alternity.species.maxSkillPointsAdjustment}}" step="1" data-dtype="Number" />
                        </div>
                        <p class="notes">{{localize "SFA.Species.MaxSkillPointsAdjustment.Hint"}}</p>
                    </div>

                </div>
            </div>

            {{#if isGM}}
            <div class="form-group">
                <button type="button" class="sfa-random-abilities-button">Random Abilities</button>
            </div>

            <hr />
            <div class="sfa-species-random-header" style="margin: 6px 0 4px;">
                <label>{{localize "SFA.Species.RandomAbilityFormulas.Header"}}</label>
                <p class="notes">{{localize "SFA.Species.RandomAbilityFormulas.Hint"}}</p>
            </div>
            <div class="sfa-species-ability-range-list" style="display:grid; gap:6px;">
                <div class="sfa-species-ability-range-row" style="display:grid; grid-template-columns:48px 28px 72px 28px 72px 54px minmax(120px,1fr); gap:6px; align-items:center; margin:0;">
                    <label style="margin:0;">{{localize "SFA.Species.RandomAbilityFormulas.STR"}}</label>
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Min"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.str.min" value="{{item.flags.sf-alternity.species.abilityRanges.str.min}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Max"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.str.max" value="{{item.flags.sf-alternity.species.abilityRanges.str.max}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Formula"}}</label>
                    <input type="text" name="flags.sf-alternity.species.abilityRanges.str.formula" value="{{item.flags.sf-alternity.species.abilityRanges.str.formula}}" style="width:100%; min-width:120px; margin:0;" />
                </div>
                <div class="sfa-species-ability-range-row" style="display:grid; grid-template-columns:48px 28px 72px 28px 72px 54px minmax(120px,1fr); gap:6px; align-items:center; margin:0;">
                    <label style="margin:0;">{{localize "SFA.Species.RandomAbilityFormulas.DEX"}}</label>
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Min"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.dex.min" value="{{item.flags.sf-alternity.species.abilityRanges.dex.min}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Max"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.dex.max" value="{{item.flags.sf-alternity.species.abilityRanges.dex.max}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Formula"}}</label>
                    <input type="text" name="flags.sf-alternity.species.abilityRanges.dex.formula" value="{{item.flags.sf-alternity.species.abilityRanges.dex.formula}}" style="width:100%; min-width:120px; margin:0;" />
                </div>
                <div class="sfa-species-ability-range-row" style="display:grid; grid-template-columns:48px 28px 72px 28px 72px 54px minmax(120px,1fr); gap:6px; align-items:center; margin:0;">
                    <label style="margin:0;">{{localize "SFA.Species.RandomAbilityFormulas.CON"}}</label>
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Min"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.con.min" value="{{item.flags.sf-alternity.species.abilityRanges.con.min}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Max"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.con.max" value="{{item.flags.sf-alternity.species.abilityRanges.con.max}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Formula"}}</label>
                    <input type="text" name="flags.sf-alternity.species.abilityRanges.con.formula" value="{{item.flags.sf-alternity.species.abilityRanges.con.formula}}" style="width:100%; min-width:120px; margin:0;" />
                </div>
                <div class="sfa-species-ability-range-row" style="display:grid; grid-template-columns:48px 28px 72px 28px 72px 54px minmax(120px,1fr); gap:6px; align-items:center; margin:0;">
                    <label style="margin:0;">{{localize "SFA.Species.RandomAbilityFormulas.INT"}}</label>
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Min"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.int.min" value="{{item.flags.sf-alternity.species.abilityRanges.int.min}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Max"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.int.max" value="{{item.flags.sf-alternity.species.abilityRanges.int.max}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Formula"}}</label>
                    <input type="text" name="flags.sf-alternity.species.abilityRanges.int.formula" value="{{item.flags.sf-alternity.species.abilityRanges.int.formula}}" style="width:100%; min-width:120px; margin:0;" />
                </div>
                <div class="sfa-species-ability-range-row" style="display:grid; grid-template-columns:48px 28px 72px 28px 72px 54px minmax(120px,1fr); gap:6px; align-items:center; margin:0;">
                    <label style="margin:0;">{{localize "SFA.Species.RandomAbilityFormulas.WIL"}}</label>
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Min"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.wil.min" value="{{item.flags.sf-alternity.species.abilityRanges.wil.min}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Max"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.wil.max" value="{{item.flags.sf-alternity.species.abilityRanges.wil.max}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Formula"}}</label>
                    <input type="text" name="flags.sf-alternity.species.abilityRanges.wil.formula" value="{{item.flags.sf-alternity.species.abilityRanges.wil.formula}}" style="width:100%; min-width:120px; margin:0;" />
                </div>
                <div class="sfa-species-ability-range-row" style="display:grid; grid-template-columns:48px 28px 72px 28px 72px 54px minmax(120px,1fr); gap:6px; align-items:center; margin:0;">
                    <label style="margin:0;">{{localize "SFA.Species.RandomAbilityFormulas.PER"}}</label>
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Min"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.per.min" value="{{item.flags.sf-alternity.species.abilityRanges.per.min}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Max"}}</label>
                    <input type="number" name="flags.sf-alternity.species.abilityRanges.per.max" value="{{item.flags.sf-alternity.species.abilityRanges.per.max}}" step="1" data-dtype="Number" style="width:72px; margin:0; text-align:center;" />
                    <label style="margin:0; text-align:right;">{{localize "SFA.Species.RandomAbilityFormulas.Formula"}}</label>
                    <input type="text" name="flags.sf-alternity.species.abilityRanges.per.formula" value="{{item.flags.sf-alternity.species.abilityRanges.per.formula}}" style="width:100%; min-width:120px; margin:0;" />
                </div>
            </div>
            {{/if}}

            {{!-- Ability Adjustments Formula --}}
            <div class="bubble">
                <h3 class="bubble-header">
                    {{localize "SFRPG.RaceAbilityAdjustments"}}
                    <a class="ability-adjustments-control add-ability-adjustment bubble-icon"><i class="fas fa-plus"></i></a>
                </h3>

                <div class="bubble-info">

                    <ol class="ability-adjustment-parts form-group">
                        {{#each itemData.abilityMods.parts as |part i| }}
                        <li class="ability-adjustment-part flexrow" data-ability-adjustment="{{i}}">
                            <input type="text" name="system.abilityMods.parts.{{i}}.0" data-dtype="Number" value="{{numberFormat part.[0] decimals=0 sign=true}}"/>
                            <select name="system.abilityMods.parts.{{i}}.1">
                                {{selectOption "" "SFRPG.None" selected=part.[1] localize=true}}
                                {{selectOptions (sfrpg "abilities") selected=part.[1]}}
                                {{selectOption "any" "SFRPG.RaceAbilityAdjustmentAny" selected=part.[1] localize=true}}
                            </select>
                            <a class="ability-adjustments-control delete-ability-adjustment"><i class="fas fa-minus"></i></a>
                        </li>
                        {{/each}}
                    </ol>

                </div>
            </div>

        </div>

        {{!-- Modifiers Tab --}}
        {{> "systems/sfrpg/templates/items/parts/item-modifiers.hbs"}}
    </section>
</form>
